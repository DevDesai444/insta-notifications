# ─────────────────────────────────────────────────────────────────────────
#  WHO TO WATCH
# ─────────────────────────────────────────────────────────────────────────
IG_TARGET_USERNAME=zero2sudo

# ─────────────────────────────────────────────────────────────────────────
#  INSTAGRAM SIGN-IN
#
#  Stories are invisible to logged-out visitors, so this is required.
#  Whichever account you use must FOLLOW @zero2sudo.
#
#  OPTION A (recommended) — a session cookie. No new account, no password
#  stored anywhere, and revocable in one click from Instagram's settings.
#    1. Log in to instagram.com in a desktop browser
#    2. F12 > Application > Cookies > https://www.instagram.com
#    3. Copy the value of the `sessionid` cookie and paste it here
# ─────────────────────────────────────────────────────────────────────────
IG_SESSIONID=

#  OPTION B — a throwaway account's username and password.
#  Never use your main account for this.
IG_USERNAME=
IG_PASSWORD=
# Only if that account has 2FA on. Paste the authenticator "setup key".
IG_TOTP_SEED=

# ─────────────────────────────────────────────────────────────────────────
#  WHERE THE NOTIFICATION GOES   (ntfy | pushover | console)
# ─────────────────────────────────────────────────────────────────────────
NOTIFY_BACKEND=ntfy

# Pick a long, unguessable topic — anyone who knows it can read your alerts.
NTFY_TOPIC=zero2sudo-alerts-CHANGE-ME-9f3a2b71
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# 5 = max priority, so iOS shows it immediately instead of batching it.
NTFY_PRIORITY=5

# Pushover alternative (paid one-off, ~$5)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ─────────────────────────────────────────────────────────────────────────
#  READING LINKS OUT OF IMAGES  (the Workday-screenshot case)
#
#  Without this, only links in the caption and in story link stickers are
#  found. With it, links that exist only as pixels in a screenshot are read
#  out of the image and become tappable.
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
VISION_ENABLED=true
VISION_MODEL=claude-opus-5
VISION_MAX_PER_POLL=12

# ─────────────────────────────────────────────────────────────────────────
#  TIMING
# ─────────────────────────────────────────────────────────────────────────
# How often to check, in seconds. 60 is a good balance. Below 30 risks
# getting the Instagram account rate-limited or blocked.
POLL_INTERVAL_SECONDS=60
POLL_JITTER=0.2
POSTS_PER_POLL=5
CHECK_STORIES=true
CHECK_POSTS=true
MAX_ITEM_AGE_HOURS=48

# ─────────────────────────────────────────────────────────────────────────
#  FILTERING
# ─────────────────────────────────────────────────────────────────────────
# true  = notify on everything he posts (recommended — you said you want the
#         chat screenshots about new grad roles too, and those are hard to
#         detect reliably from a caption)
# false = only notify when a link is found or a keyword below matches
NOTIFY_ALL=true
KEYWORDS=new grad,newgrad,entry level,university grad,intern,2026,2027,swe,software engineer,hiring,apply,workday,greenhouse,lever,referral

# ─────────────────────────────────────────────────────────────────────────
#  STORAGE
# ─────────────────────────────────────────────────────────────────────────
# Holds the Instagram session and the "already notified" database.
# Keep this on a persistent disk, or you will get repeat notifications.
DATA_DIR=data
SEED_ON_FIRST_RUN=true
